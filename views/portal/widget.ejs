<%
  const o = profile.options;
  const base = '/portal/' + ctx.id;
  const local = ['voucher', 'password', 'email'].filter(k => methods[k]);
  const anything = methods.sso.length || local.length || methods.click;
  const terms = o.terms_enabled && anything;
  const checkbox = terms && o.terms_mode === 'checkbox';
  const clickLabel = (profile.methods.click.button_text || 'Continue as guest');
  const tabLabel = { voucher: 'Voucher', password: 'Password', email: 'Email' };
  const icons = {
    google: '<svg viewBox="0 0 48 48" width="20" height="20" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>',
    microsoft: '<svg viewBox="0 0 23 23" width="18" height="18" aria-hidden="true"><path fill="#f35325" d="M1 1h10v10H1z"/><path fill="#81bc06" d="M12 1h10v10H12z"/><path fill="#05a6f0" d="M1 12h10v10H1z"/><path fill="#ffba08" d="M12 12h10v10H12z"/></svg>',
    facebook: '<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="#1877F2" d="M24 12a12 12 0 1 0-13.9 11.9v-8.4H7.1V12h3V9.4c0-3 1.8-4.7 4.5-4.7 1.3 0 2.7.2 2.7.2v3h-1.5c-1.5 0-2 .9-2 1.9V12h3.4l-.5 3.5h-2.9v8.4A12 12 0 0 0 24 12z"/></svg>',
    apple: '<svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true"><path fill="currentColor" d="M16.4 12.6c0-2.6 2.1-3.8 2.2-3.9-1.2-1.8-3.1-2-3.7-2-1.6-.2-3.1.9-3.9.9-.8 0-2-.9-3.4-.9-1.7 0-3.3 1-4.2 2.6-1.8 3.1-.5 7.7 1.3 10.2.9 1.2 1.9 2.6 3.2 2.6 1.3-.1 1.8-.8 3.3-.8 1.6 0 2 .8 3.4.8 1.4 0 2.3-1.3 3.1-2.5 1-1.4 1.4-2.8 1.4-2.9 0 0-2.7-1-2.7-4.1zM13.8 5c.7-.9 1.2-2 1.1-3.2-1 0-2.3.7-3 1.6-.7.8-1.3 2-1.1 3.1 1.1.1 2.3-.6 3-1.5z"/></svg>',
    oidc: '<svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="8" cy="15" r="4"/><path d="M10.8 12.2 20 3m-3 3 3 3m-6-1 2 2"/></svg>',
    saml: '<svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6"/></svg>',
  };
  const alertIcon = '<svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M10 2a8 8 0 1 0 0 16 8 8 0 0 0 0-16Zm0 4a1 1 0 0 1 1 1v3.5a1 1 0 1 1-2 0V7a1 1 0 0 1 1-1Zm0 8.5a1.1 1.1 0 1 1 0-2.2 1.1 1.1 0 0 1 0 2.2Z"/></svg>';
  const hidden = '<input type="hidden" name="accept" value="' + (terms && !checkbox ? '1' : '') + '">';
%>
<div id="cp-login" class="cp-login cp-theme-<%= o.widget_theme === 'dark' ? 'dark' : 'light' %>" data-active="<%= values._method || '' %>" style="--cp-accent: <%= o.accent %>">
  <% if (preview && o.maintenance) { %><div class="cp-note"><b>Maintenance mode is on.</b> Guests see a "setting things up" message instead of these sign-in options.</div>
  <% } else if (preview) { %><div class="cp-note">Preview: sign-ins here don't connect a real device.</div><% } %>
  <% if (locals.maintenance) { %>
    <div class="cp-maint" role="status">
      <div class="cp-maint-ico"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.4-.6-.6-2.4 2.5-2.5Z"/></svg></div>
      <h2>Back shortly</h2>
      <p><%= o.maintenance_message || 'WiFi sign-in will be available again shortly.' %></p>
    </div>
  <% } else { %>
  <% if (error) { %><div class="cp-error" role="alert"><%- alertIcon %><span><%= error %></span></div><% } %>
  <% if (!anything) { %><div class="cp-error"><%- alertIcon %><span>No sign-in methods are switched on for this network yet.</span></div><% } %>

  <% if (methods.sso.length) { %>
    <div class="cp-sso">
      <% methods.sso.forEach(function (s) { %>
        <form method="post" action="<%= base %>/sso/<%= s.key %>">
          <%- hidden %>
          <button type="submit" class="cp-btn cp-btn-sso cp-<%= s.key %>"><span class="cp-ico"><%- icons[s.type] %></span><span class="cp-btn-label"><%= s.label %></span></button>
        </form>
      <% }) %>
    </div>
  <% } %>

  <% if (methods.sso.length && local.length) { %><div class="cp-divider"><span>or</span></div><% } %>

  <% if (local.length > 1) { %>
    <div class="cp-tabs" role="tablist">
      <% local.forEach(function (k, i) { %>
        <button type="button" role="tab" class="cp-tab<%= i === 0 ? ' active' : '' %>" data-tab="<%= k %>"><%= tabLabel[k] %></button>
      <% }) %>
    </div>
  <% } %>

  <% if (methods.voucher) { %>
    <form method="post" action="<%= base %>/login/voucher" class="cp-panel" data-panel="voucher">
      <%- hidden %>
      <label class="cp-label" for="cp-code">Voucher code</label>
      <input class="cp-input cp-code" id="cp-code" name="code" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="XXXX-XXXX" required value="<%= values.code || '' %>">
      <button class="cp-btn cp-btn-primary" type="submit"><span class="cp-btn-label">Connect</span></button>
    </form>
  <% } %>

  <% if (methods.password) { %>
    <form method="post" action="<%= base %>/login/password" class="cp-panel" data-panel="password">
      <%- hidden %>
      <label class="cp-label" for="cp-password">Network password</label>
      <input class="cp-input" id="cp-password" type="password" name="password" autocomplete="current-password" placeholder="Enter password" required>
      <button class="cp-btn cp-btn-primary" type="submit"><span class="cp-btn-label">Connect</span></button>
    </form>
  <% } %>

  <% if (methods.email) { %>
    <form method="post" action="<%= base %>/login/email" class="cp-panel" data-panel="email">
      <%- hidden %>
      <% if (profile.methods.email.require_name) { %>
        <label class="cp-label" for="cp-name">Your name</label>
        <input class="cp-input" id="cp-name" name="name" autocomplete="name" placeholder="Jane Smith" required value="<%= values.name || '' %>">
      <% } %>
      <label class="cp-label" for="cp-email">Email address</label>
      <input class="cp-input" id="cp-email" type="email" name="email" autocomplete="email" inputmode="email" placeholder="you@example.com" required value="<%= values.email || '' %>">
      <% if (profile.methods.email.marketing_optin) { %>
        <label class="cp-check"><input type="checkbox" name="marketing" value="1"><span>Send me occasional news and offers</span></label>
      <% } %>
      <button class="cp-btn cp-btn-primary" type="submit"><span class="cp-btn-label">Connect</span></button>
    </form>
  <% } %>

  <% if (methods.click) { %>
    <form method="post" action="<%= base %>/login/click" class="cp-click<%= local.length || methods.sso.length ? ' cp-click-secondary' : '' %>">
      <%- hidden %>
      <% if (local.length || methods.sso.length) { %>
        <button class="cp-link-btn" type="submit"><%= local.length ? 'No code? ' : '' %><span><%= clickLabel %></span> <span aria-hidden="true">→</span></button>
      <% } else { %>
        <button class="cp-btn cp-btn-primary" type="submit"><span class="cp-btn-label"><%= clickLabel %></span></button>
      <% } %>
    </form>
  <% } %>

  <% if (terms) { %>
    <div class="cp-terms" id="cp-terms">
      <% if (checkbox) { %>
        <label class="cp-check"><input type="checkbox" id="cp-accept" <%= values.accept ? 'checked' : '' %>><span>I agree to the <a href="#cp-terms-text" class="cp-terms-link">terms of use</a></span></label>
      <% } else { %>
        <p>By connecting you agree to the <a href="#cp-terms-text" class="cp-terms-link">terms of use</a>.</p>
      <% } %>
      <div class="cp-terms-text" id="cp-terms-text" role="dialog" aria-label="Terms of use">
        <div class="cp-terms-box">
          <div class="cp-terms-head"><strong>Terms of use</strong><a href="#" class="cp-terms-close" aria-label="Close">×</a></div>
          <div class="cp-terms-body"><%= o.terms_text %></div>
        </div>
      </div>
    </div>
  <% } %>
  <% } %>
</div>
