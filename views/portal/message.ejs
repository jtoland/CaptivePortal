<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title><%= title %></title>
<link rel="stylesheet" href="/static/portal.css">
</head>
<body class="cp-plain">
<div class="cp-login cp-standalone">
  <div class="cp-msg-ico"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12.5a10 10 0 0 1 14 0M8.5 16a5 5 0 0 1 7 0"/><circle cx="12" cy="19.5" r="1" fill="currentColor"/><path d="M2 9a14.5 14.5 0 0 1 20 0"/></svg></div>
  <h1><%= title %></h1>
  <p><%= message %></p>
  <% if (link) { %><p style="margin-top:14px"><a href="<%= link.href %>"><%= link.text %></a></p><% } %>
</div>
</body>
</html>
