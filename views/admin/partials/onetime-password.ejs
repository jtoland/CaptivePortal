<div class="onetime">
  <div class="onetime-head"><%- icon('key', 18) %><b><%= heading %></b></div>
  <p>Give this password to <b><%= who.display_name || who.username %></b> (username <code><%= who.username %></code>). <b>It won't be shown again.</b>
    <%= who.must_change_password ? 'They’ll choose their own password when they first sign in.' : '' %></p>
  <span class="copy-field big"><code><%= password %></code><button type="button" class="copy-btn" data-copy="<%= password %>" title="Copy password"><%- icon('copy', 16) %></button></span>
  <button type="button" class="btn sm mt" data-copy-text="Captive Portal admin&#10;Address: http://<%= locals.host || '' %>/admin&#10;Username: <%= who.username %>&#10;Password: <%= password %>">Copy sign-in details</button>
</div>
