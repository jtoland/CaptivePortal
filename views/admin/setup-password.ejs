<%- include('partials/auth-head', { title: 'Choose a password' }) %>
  <form method="post" action="/admin/account/password" class="stack">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <h1>Choose your own password</h1>
    <p class="muted">Hi <b><%= me.display_name || me.username %></b>. You signed in with a temporary password, so please set your own before continuing.</p>
    <% if (error) { %><div class="flash err slim"><span><%= error %></span></div><% } %>
    <label>New password <input type="password" name="next" id="pw-new" autocomplete="new-password" minlength="10" required autofocus><small>At least 10 characters.</small></label>
    <label>Confirm new password <input type="password" name="confirm" id="pw-confirm" autocomplete="new-password" minlength="10" required></label>
    <div class="suggest">
      <span class="small muted">Need one? Here's a strong one:</span>
      <span class="copy-field"><code><%= suggestion %></code><button type="button" class="copy-btn" data-copy="<%= suggestion %>" title="Copy"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.75"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/></svg></button></span>
      <button type="button" class="btn sm" data-use-password="<%= suggestion %>">Use this password</button>
    </div>
    <button class="btn primary block" type="submit">Save and continue</button>
  </form>
  <form method="post" action="/admin/logout" class="center mt"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="linkish">Sign out</button></form>
<%- include('partials/auth-foot') %>
