<%- include('partials/auth-head', { title: 'Two-factor sign-in' }) %>
  <form method="post" action="/admin/login/2fa" class="stack">
    <h1>Enter your code</h1>
    <p class="muted">Open your authenticator app and enter the 6-digit code for <b>Captive Portal</b>.</p>
    <% if (error) { %><div class="flash err slim"><span><%= error %></span></div><% } %>
    <input class="otp-input" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9 ]{6,8}|[A-Za-z0-9-]{10,11}" placeholder="123 456" required autofocus>
    <button class="btn primary block" type="submit">Verify</button>
    <details class="small muted"><summary>Lost your phone?</summary>
      <p class="mt-xs">Enter one of your recovery codes (like <code>a1b2c-3d4e5</code>) in the box above. If you don't have any, ask another admin to reset your two-factor.</p></details>
    <p class="small"><a href="/admin/login">← Use a different account</a></p>
  </form>
<%- include('partials/auth-foot') %>
