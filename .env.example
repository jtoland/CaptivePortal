# Initial admin login for http://<this-host>/admin (change the password after first login)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-now

# Optional: the LAN IP guests are redirected to (shown in the setup checklist)
PORTAL_IP=192.168.1.50

# Optional fallback for the public HTTPS address. Normally set it in the admin UI:
# Settings → Hotspot setup → Public HTTPS address
PUBLIC_URL=

# --- Emergency / advanced (leave unset normally) ---
# Lets any device open /admin, bypassing "Who can open the admin". Use only to get back in, then remove.
# ADMIN_ALLOW_ALL=1
# Stops /admin redirecting to HTTPS once a certificate is active.
# ADMIN_ALLOW_HTTP=1
# Set to 1 only if you put your own reverse proxy in front of the portal.
# TRUST_PROXY=1
